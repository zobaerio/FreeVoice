{
  "name": "freevoice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "desktop:package": "npm run build && electron-builder --win nsis --x64",
    "test": "node --test"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/filesystem": "^7.1.4",
    "@capacitor/share": "^7.0.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "vite": "^6.0.7",
    "typescript": "^5.7.3"
  },
  "build": {
    "appId": "com.zobaerio.freevoice",
    "productName": "FreeVoice",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "FreeVoice-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FreeVoice",
      "uninstallDisplayName": "FreeVoice"
    },
    "extraResources": [
      {
        "from": "electron/indicf5_runner.py",
        "to": "python/indicf5_runner.py",
      {
        "from": "electron/indicf5_diagnostics.py",
        "to": "python/indicf5_diagnostics.py"
      }
      }
    ]
  }
}
